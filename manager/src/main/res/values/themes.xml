<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        windowAnimationStyle 一次配四个方向，所有 Activity（含以后新增的）自动一致：
        前进 = 新页右进（300ms）+ 旧页左移淡出（200ms）
        返回 = 上页回位（250ms）+ 当前页右出（200ms）
        不用 overridePendingTransition 逐页写：漏一个页面就出现硬切，
        而这种漏在测试里很难被发现。规范见 docs/design-system/MOTION.md。
    -->
    <style name="Theme.HuanZhi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.HuanZhi.Activity</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.HuanZhi.Dialog</item>
    </style>

    <style name="Animation.HuanZhi.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nav_enter_forward</item>
        <item name="android:activityOpenExitAnimation">@anim/nav_exit_forward</item>
        <item name="android:activityCloseEnterAnimation">@anim/nav_enter_back</item>
        <item name="android:activityCloseExitAnimation">@anim/nav_exit_back</item>
    </style>

    <style name="Animation.HuanZhi.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- 只覆盖动画，颜色/形状仍然继承 M3 的对话框外观 -->
    <style name="ThemeOverlay.HuanZhi.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/Animation.HuanZhi.Dialog</item>
    </style>
</resources>
