<?xml version="1.0" encoding="utf-8"?>
<!-- 当前页退出：右移 6% 并淡出，200ms，方向与前进相反 -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <translate
        android:duration="200"
        android:fromXDelta="0"
        android:interpolator="@interpolator/m3_emphasized_accelerate"
        android:toXDelta="6%p" />

    <alpha
        android:duration="200"
        android:fromAlpha="1"
        android:interpolator="@interpolator/m3_standard_accelerate"
        android:toAlpha="0" />
</set>
