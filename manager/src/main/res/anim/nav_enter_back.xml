<?xml version="1.0" encoding="utf-8"?>
<!-- 返回：上一页从左侧 -3% 回到原位并淡入，250ms（比前进略快，返回是「已知去向」的动作） -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <translate
        android:duration="250"
        android:fromXDelta="-3%p"
        android:interpolator="@interpolator/m3_emphasized_decelerate"
        android:toXDelta="0" />

    <alpha
        android:duration="250"
        android:fromAlpha="0"
        android:interpolator="@interpolator/m3_standard_decelerate"
        android:toAlpha="1" />
</set>
