<?xml version="1.0" encoding="utf-8"?>
<!--
    主体已经烘进背景层位图（ic_launcher_bg），所以前景层留空。
    这样做的好处：各启动器的裁剪形状不同（圆/方圆/水滴），
    主体只要在中心 72/108 的安全区内就都不会被切到。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@color/icon_foreground_empty" />
</adaptive-icon>
