<?xml version="1.0" encoding="utf-8"?>
<!-- 单个应用创建分身：名称 + 份数，一份和多份都走这一个弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <!-- 加固壳提示：命中才显示，不打断创建，只把风险说在前面 -->
    <TextView
        android:id="@+id/warnHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_warn"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/badge_warn_text"
        android:visibility="gone"
        tools:text="检测到「360 加固」加固壳" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/clone_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="24"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 名称预览：多份时前缀会拼上序号，先说清楚最终长什么样 -->
    <TextView
        android:id="@+id/namePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="将命名为：微信 · 分身1" />

    <!-- 逐份命名：不想用「基础名 · 分身N」时，逐份单独起名 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/perCopyBtn"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="@string/name_per_copy"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:value="1"
        android:valueFrom="1"
        android:valueTo="10"
        app:labelBehavior="gone" />

    <TextView
        android:id="@+id/countHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/spaceHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
