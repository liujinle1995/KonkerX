<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 枚举可分身应用 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 安装 / 卸载分身 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        运行概览要用它读每个分身的存储占用与最近启动时间。
        声明不等于获得：还要用户在「使用情况访问权限」里手动授予，
        没授权时页面只显示安装包体积，功能不受影响。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".ManagerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HuanZhi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="@string/pick_app" />

        <activity
            android:name=".BuildActivity"
            android:exported="false"
            android:label="@string/bp_title" />

        <activity
            android:name=".RuntimeActivity"
            android:exported="false"
            android:label="@string/runtime" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/plugin_info" />

        <activity
            android:name=".ManualActivity"
            android:exported="false"
            android:label="@string/manual_title" />

        <receiver
            android:name=".core.InstallReceiver"
            android:exported="false" />

        <!--
            分身被卸载后自动删记录。两个 action 都是受保护广播（只有系统能发），
            data scheme="package" 是收到包名（data.ssp）的必要条件。
        -->
        <receiver
            android:name=".core.PackageGoneReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
